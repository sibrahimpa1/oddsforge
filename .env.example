# Everything is optional. With no keys the app runs fully on the bundled data:
# historical results/odds/xG for the backtest and Replay, the ESPN snapshot for live fixtures.

# Claude match analyst (offline template is used when empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# The Odds API: multi-book 1X2, spreads and totals for upcoming MLS games (https://the-odds-api.com)
ODDS_API_KEY=

# Storage (SQLite by default). For Postgres: postgresql+psycopg://user:pass@host:5432/oddsforge
DATABASE_URL=

# API behaviour
CORS_ORIGINS=http://localhost:3000
ODDSFORGE_SCHEDULER=1            # refresh fixtures/results/odds and settle bets every N minutes
ODDSFORGE_REFRESH_MINUTES=30
ODDSFORGE_OFFLINE=0              # 1 = never call external services

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
